network:
  version: 2
  renderer: networkd
  ethernets:
    {{ interface_name }}:
      dhcp4: false
      addresses:
        - {{ static_ip_cidr }}
      routes:
        - to: default
          via: {{ gateway_ip }}
      nameservers:
        addresses:
          - {{ dns_server_1 }}
          - {{ dns_server_2 }}