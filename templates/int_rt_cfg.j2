{# Interface P-PE Configuration Template #}
!
{% for interface in interfaces -%}
{% if interface.mode == "routing" -%}
interface {{ interface.name }}
  description {{ interface.description }}
  ip address {{ interface.ip_address }} {{ interface.subnet_mask }}
  no shutdown
{% if interface.isis_name %}
  ip router isis {{ interface.isis_name }}
{% endif %}
{% if interface.mpls_ip == True %}
  mpls ip
{% endif %}
{% if interface.vrf_name %}
  ip vrf forwarding {{ interface.vrf_name }}
{% endif %}
!
{% endif -%}
{% endfor -%}